{
  "$meta": {
    "brand": "Isabel & Gareth Wedding",
    "designer": "Rachel Doran",
    "source": "Isabel&Gareth Wedding Stationary Brand Guidelines.pdf (May 2026)",
    "keywords": ["Fun", "Ornate", "Illustrative", "Colourful", "Playful", "Polished", "Luxurious", "Warm", "Bold", "Artsy", "Vibrant", "British", "Indulgent", "Eclectic", "Expressive", "Maximalist"]
  },
  "color": {
    "red":        { "hex": "#BF1326", "role": "primary",   "usage": "backgrounds & key elements" },
    "purple":     { "hex": "#631853", "role": "primary",   "usage": "backgrounds & key elements" },
    "aubergine":  { "hex": "#47153C", "role": "base",      "usage": "text on light backgrounds, illustration outlines, backgrounds" },
    "cream":      { "hex": "#FBF2E7", "role": "base",      "usage": "text on dark backgrounds, small accents, contrast & space" },
    "orange":     { "hex": "#EF733A", "role": "secondary", "usage": "small accents, contrasts primary shades, warmth & energy" },
    "pink":       { "hex": "#E38296", "role": "secondary", "usage": "small accents, harmony with primary shades" },
    "lilac":      { "hex": "#E3C5FF", "role": "tertiary",  "usage": "small accents, complements purples" },
    "yellow":     { "hex": "#FCD59F", "role": "tertiary",  "usage": "small accents, brightness and warmth" },
    "pastelPink": { "hex": "#FFDFE1", "role": "tertiary",  "usage": "light background option" }
  },
  "pairings": {
    "$note": "Approved background + text-colour combinations (page 7). Text legibility comes first; let illustrations/patterns carry the rest of the palette. Use a few of these as defaults.",
    "combinations": [
      { "background": "red",        "text": ["cream"] },
      { "background": "purple",     "text": ["cream"] },
      { "background": "aubergine",  "text": ["cream"] },
      { "background": "orange",     "text": ["cream", "aubergine"] },
      { "background": "pink",       "text": ["aubergine"] },
      { "background": "lilac",      "text": ["aubergine"] },
      { "background": "pastelPink", "text": ["purple", "aubergine"] },
      { "background": "cream",      "text": ["purple", "aubergine"] }
    ]
  },
  "typography": {
    "primary": {
      "role": "Names, headings, key moments",
      "family": "PP Acma",
      "weight": "Black",
      "source": "Pangram Pangram Foundry (paid — local file: PPAcma-Black.otf)",
      "webFallbacks": ["Abril Fatface", "DM Serif Display", "Yeseva One"]
    },
    "bodyPrimary": {
      "role": "Core body copy",
      "family": "Barlow",
      "weight": "Bold (700)",
      "source": "Google Fonts",
      "webFallbacks": ["Chivo", "Futura", "Jost", "Lato", "Manrope", "Mukta"]
    },
    "bodySupporting": {
      "role": "Supporting / space-constrained / small text",
      "family": "Barlow Condensed",
      "weight": "Medium (500)",
      "source": "Google Fonts (local files: BarlowCondensed-Medium.ttf, BarlowCondensed-Bold.ttf)",
      "webFallbacks": ["Fira Sans", "Roboto Condensed", "Oswald"]
    }
  }
}
